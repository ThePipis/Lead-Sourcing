{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lead-sourcing",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "USE_BUILTIN_API": "true"
  }
}
